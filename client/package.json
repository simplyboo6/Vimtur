{
  "name": "client",
  "version": "5.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --output-path dist",
    "build:watch": "ng build --watch --output-path dist",
    "build:prod": "ng build --configuration production --output-path dist",
    "serve": "ng serve --host 0.0.0.0 --disable-host-check --watch --proxy-config ./proxy-config.json --port 8455",
    "watch": "ng build --watch --output-path dist",
    "lint": "ng lint && prettier --check '**/*.{ts,js,json,md,tsx,html,scss,css,yaml,yml}'",
    "fix": "ng lint --fix && prettier --check --write '**/*.{ts,js,json,md,tsx,html,scss,css,yaml,yml}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@fortawesome/angular-fontawesome": "0.15",
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@ng-bootstrap/ng-bootstrap": "17",
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.3.8",
    "hls.js": "^1.7.3",
    "is-mobile": "^2.2.2",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.0.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular-eslint/builder": "18",
    "@angular-eslint/eslint-plugin": "18",
    "@angular-eslint/eslint-plugin-template": "18",
    "@angular-eslint/schematics": "18",
    "@angular-eslint/template-parser": "18",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/language-service": "^18.2.14",
    "@angular/localize": "18.2.14",
    "@types/node": "^14.0.22",
    "@types/socket.io-client": "^1.4.32",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "@typescript-eslint/types": "7.11.0",
    "@typescript-eslint/utils": "7.11.0",
    "@vimtur/common": "../common",
    "eslint": "^8.57.1",
    "prettier": "^1.19.1",
    "ts-node": "^8.6.2",
    "tslint": "~6.1.0",
    "typescript": "5.4.5"
  },
  "packageManager": "yarn@4.8.1"
}
