{
  "name": "client",
  "version": "5.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --output-path dist",
    "build:watch": "ng build --watch --output-path dist",
    "build:prod": "ng build --configuration production --output-path dist",
    "serve": "ng serve --host 0.0.0.0 --disable-host-check --watch --proxy-config ./proxy-config.json --port 8455",
    "watch": "ng build --watch --output-path dist",
    "lint": "ng lint && prettier --check '**/*.{ts,js,json,md,tsx,html,scss,css,yaml,yml}'",
    "fix": "ng lint --fix && prettier --check --write '**/*.{ts,js,json,md,tsx,html,scss,css,yaml,yml}'"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/angular-fontawesome": "5.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ng-bootstrap/ng-bootstrap": "21",
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.3.8",
    "hls.js": "^1.7.3",
    "is-mobile": "^2.2.2",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.0.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular-eslint/builder": "22",
    "@angular-eslint/eslint-plugin": "22",
    "@angular-eslint/eslint-plugin-template": "22",
    "@angular-eslint/schematics": "22",
    "@angular-eslint/template-parser": "22",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@angular/localize": "22.2.3",
    "@types/node": "^24.19.2",
    "@vimtur/common": "../common",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "yarn@4.8.1",
  "resolutions": {
    "@vimtur/common": "portal:../common"
  }
}
